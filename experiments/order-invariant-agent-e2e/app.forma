// Order approval and inventory, using the ten Forma v0 primitives plus the
// experimental self-only Invariant, bounded Changes, relation-value, numeric
// addition, and Action Precondition slices.

role admin
role staff

type Sku      = String matches /[A-Z0-9-]+/
type Quantity = Int min 0

entity Customer {
    name  String required label
    email String required unique
}

entity Product {
    sku   Sku required unique
    name  String required label
    price Decimal required
}

entity StockItem {
    product  Product
    location String required label
    onHand   Quantity required
    reserved Quantity required

    invariant stockAvailable: reserved <= onHand
}

entity Order {
    number   String required unique label
    customer Customer
    lines    [OrderLine]

    state status Draft | Submitted | Approved | Rejected | Shipped initial Draft
}

entity OrderLine {
    order    Order
    product  Product
    quantity Quantity required
}

entity StockReservation {
    code              String required unique label
    stock             StockItem required
    plan              ReservationPlan required
    requestedReserved Quantity required

    state status Pending | Committed initial Pending
}

entity ReservationPlan {
    code             String required unique label
    approvedReserved Quantity required
    requestCeiling   Quantity required
}

action Order.submit:  Draft     -> Submitted
action Order.approve: Submitted -> Approved confirm allow admin
action Order.reject:  Submitted -> Rejected allow admin
action Order.ship:    Approved  -> Shipped  allow staff

action StockReservation.commit: Pending -> Committed confirm allow staff {
    precondition withinRequestLimit: stock.reserved + requestedReserved <= plan.requestCeiling

    changes {
        stock.reserved = stock.reserved + plan.approvedReserved
    }
}

page Orders {
    allow admin, staff

    list Order {
        columns number, customer, status
        search number
        filter status, customer
        sort number asc
        paginate 20
        actions create, view, edit, delete, submit, approve, reject, ship
    }
}

page OrderCreate {
    allow staff

    form Order {
        fields number, customer
        submit create
    }
}

page OrderDetail(order Order) {
    allow admin, staff

    detail order {
        fields number, customer, status
        actions edit, delete, submit, approve, reject, ship
    }
}

page OrderEdit(order Order) {
    allow staff

    form order {
        fields number, customer
        submit edit
    }
}

page StockItems {
    allow admin, staff

    list StockItem {
        columns location, product, onHand, reserved
        search location
        filter product
        sort location asc
        paginate 20
        actions view, edit
    }
}

page StockItemDetail(item StockItem) {
    allow admin, staff

    detail item {
        fields location, product, onHand, reserved
        actions edit
    }
}

page StockItemEdit(item StockItem) {
    allow admin

    form item {
        fields location, product, onHand, reserved
        submit edit
    }
}

page Reservations {
    allow staff

    list StockReservation {
        columns code, stock, plan, requestedReserved, status
        actions commit
    }
}

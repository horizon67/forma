func request(t *testing.T, client *http.Client, method, target, body, role string) *http.Response {
	t.Helper()
	request, err := http.NewRequest(method, target, strings.NewReader(body))
	if err != nil {
		t.Fatal(err)
	}
	if body != "" {
		request.Header.Set("Content-Type", "application/x-www-form-urlencoded")
	}
	request.AddCookie(&http.Cookie{Name: "forma_role", Value: role})
	response, err := client.Do(request)
	if err != nil {
		t.Fatal(err)
	}
	return response
}

var submissionTokenPattern = regexp.MustCompile(`name="_forma_submission" value="([^"]+)"`)

func addSubmissionToken(t *testing.T, client *http.Client, target, role string, values url.Values) {
	t.Helper()
	response := request(t, client, http.MethodGet, target, "", role)
	assertStatus(t, response, http.StatusOK)
	body, err := io.ReadAll(response.Body)
	response.Body.Close()
	if err != nil {
		t.Fatal(err)
	}
	values.Set("_forma_submission", submissionTokenFromBody(t, body))
}

func submissionTokenFromBody(t *testing.T, body []byte) string {
	t.Helper()
	match := submissionTokenPattern.FindSubmatch(body)
	if len(match) != 2 {
		t.Fatalf("form has no submission token: %s", body)
	}
	return string(match[1])
}

func assertStatus(t *testing.T, response *http.Response, want int) {
	t.Helper()
	if response.StatusCode != want {
		body, _ := io.ReadAll(response.Body)
		response.Body.Close()
		t.Fatalf("status = %d, want %d; body: %s", response.StatusCode, want, body)
	}
}

func assertBodyContains(t *testing.T, response *http.Response, values ...string) {
	t.Helper()
	body, err := io.ReadAll(response.Body)
	response.Body.Close()
	if err != nil {
		t.Fatal(err)
	}
	for _, value := range values {
		if !strings.Contains(string(body), value) {
			t.Errorf("body does not contain %q", value)
		}
	}
}

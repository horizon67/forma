func TestEvictedSubmissionPreservesInputAndCanBeRetried(t *testing.T) {
	app, err := newApplication()
	if err != nil {
		t.Fatal(err)
	}
	server := httptest.NewServer(app.handler())
	defer server.Close()
	client := server.Client()
	client.CheckRedirect = func(request *http.Request, via []*http.Request) error {
		return http.ErrUseLastResponse
	}

	form := url.Values{"name": {"Alice from old tab"}, "email": {"alice@example.com"}, "team": {"team-design"}, "plan": {"Pro"}}
	addSubmissionToken(t, client, server.URL+"/users/user-alice/edit", "admin", form)
	for index := 0; index < maxSubmissionTokensPerScope; index++ {
		addSubmissionToken(t, client, server.URL+"/users/user-alice/edit", "admin", url.Values{})
	}

	response := request(t, client, http.MethodPost, server.URL+"/users/user-alice/edit", form.Encode(), "admin")
	assertStatus(t, response, http.StatusConflict)
	body, err := io.ReadAll(response.Body)
	response.Body.Close()
	if err != nil {
		t.Fatal(err)
	}
	for _, want := range []string{
		"This form expired. Review the values and save again.", `value="Alice from old tab"`,
		`value="team-design" selected`, "Forma admin experiment",
	} {
		if !strings.Contains(string(body), want) {
			t.Errorf("expired form does not contain %q", want)
		}
	}
	form.Set("_forma_submission", submissionTokenFromBody(t, body))
	response = request(t, client, http.MethodPost, server.URL+"/users/user-alice/edit", form.Encode(), "admin")
	assertStatus(t, response, http.StatusSeeOther)
	response.Body.Close()
}

func TestSubmissionGuardIsBoundedAndPrincipalBound(t *testing.T) {
	guard := newSubmissionGuard()
	var tokens []string
	for index := 0; index < maxSubmissionTokensPerScope+1; index++ {
		token, err := guard.issue("user-alice", "admin-a")
		if err != nil {
			t.Fatal(err)
		}
		if strings.Contains(token, "user-alice") {
			t.Fatalf("submission token exposes its record: %q", token)
		}
		tokens = append(tokens, token)
	}
	if got := len(guard.issued); got != maxSubmissionTokensPerScope {
		t.Fatalf("outstanding tokens = %d", got)
	}
	if decision, _ := guard.begin(tokens[0], "user-alice", "admin-a"); decision != submissionRejected {
		t.Fatalf("evicted token decision = %v", decision)
	}
	latest := tokens[len(tokens)-1]
	if decision, _ := guard.begin(latest, "user-alice", "admin-b"); decision != submissionRejected {
		t.Fatalf("other principal decision = %v", decision)
	}
	if decision, _ := guard.begin(latest, "user-alice", "admin-a"); decision != submissionAccepted {
		t.Fatalf("owner decision = %v", decision)
	}
	if decision, _ := guard.begin(latest, "user-alice", "admin-a"); decision != submissionInProgress {
		t.Fatalf("concurrent duplicate decision = %v", decision)
	}
	guard.complete(latest, "/users/user-alice?updated=1")
	if decision, redirect := guard.begin(latest, "user-alice", "admin-a"); decision != submissionCompleted || redirect != "/users/user-alice?updated=1" {
		t.Fatalf("completed decision = %v %q", decision, redirect)
	}
}

func TestSubmissionGuardBoundsCompletedResults(t *testing.T) {
	guard := newSubmissionGuard()

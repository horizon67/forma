		token, err := guard.issue("user-alice", "admin")
		if err != nil {
			t.Fatal(err)
		}
		if decision, _ := guard.begin(token, "user-alice", "admin"); decision != submissionAccepted {
			t.Fatalf("begin decision = %v", decision)
		}
		guard.complete(token, "/users/user-alice?updated=1")
	}
	if got := len(guard.completed); got != maxSubmissionTokensPerScope {
		t.Fatalf("completed tokens = %d", got)
	}
}


func TestGeneratedAdminFlow(t *testing.T) {
	app, err := newApplication()
	if err != nil {
		t.Fatal(err)
	}
	server := httptest.NewServer(app.handler())
	defer server.Close()

	client := server.Client()
	client.CheckRedirect = func(request *http.Request, via []*http.Request) error {
		return http.ErrUseLastResponse
	}

	response := request(t, client, http.MethodGet, server.URL+"/users", "", "admin")
	assertStatus(t, response, http.StatusOK)
	assertBodyContains(t, response, "Alice Tanaka", "alice@example.com", "Platform", "Pro", "Active")

	response = request(t, client, http.MethodGet, server.URL+"/users/user-alice", "", "admin")
	assertStatus(t, response, http.StatusOK)
	assertBodyContains(t, response, "Record detail", "Alice Tanaka", "alice@example.com")

	response = request(t, client, http.MethodGet, server.URL+"/users/user-alice/edit", "", "admin")
	assertStatus(t, response, http.StatusOK)
	assertBodyContains(t, response, `name="email" type="text"`, `value="team-platform" selected`,
		`name="_forma_submission"`, `data-prevent-duplicate="true"`, `data-pending-label="Saving…"`)

	invalid := url.Values{"name": {"Alice Submitted"}, "email": {""}, "team": {"team-design"}, "plan": {"Pro"}}
	addSubmissionToken(t, client, server.URL+"/users/user-alice/edit", "admin", invalid)
	response = request(t, client, http.MethodPost, server.URL+"/users/user-alice/edit", invalid.Encode(), "admin")
	assertStatus(t, response, http.StatusUnprocessableEntity)
	assertBodyContains(t, response, "Email is required", `value="Alice Submitted"`, `value="team-design" selected`)
	response = request(t, client, http.MethodPost, server.URL+"/users/user-alice/edit", invalid.Encode(), "admin")
	assertStatus(t, response, http.StatusConflict)
	assertBodyContains(t, response, "This form expired. Review the values and save again.",
		`value="Alice Submitted"`, `value="team-design" selected`, "Forma admin experiment")

	response = request(t, client, http.MethodGet, server.URL+"/users/user-alice", "", "admin")
	assertStatus(t, response, http.StatusOK)
	assertBodyContains(t, response, "Alice Tanaka", "Platform")

	invalidRelation := url.Values{"name": {"Alice Submitted"}, "email": {"alice@example.com"}, "team": {"team-missing"}, "plan": {"Pro"}}
	addSubmissionToken(t, client, server.URL+"/users/user-alice/edit", "admin", invalidRelation)
	response = request(t, client, http.MethodPost, server.URL+"/users/user-alice/edit", invalidRelation.Encode(), "admin")
	assertStatus(t, response, http.StatusUnprocessableEntity)
	assertBodyContains(t, response, "Team is not selectable")

	form := url.Values{"name": {"Alice Tanaka Updated"}, "email": {"alice@example.com"}, "team": {"team-design"}, "plan": {"Enterprise"}}
	addSubmissionToken(t, client, server.URL+"/users/user-alice/edit", "admin", form)
	response = request(t, client, http.MethodPost, server.URL+"/users/user-alice/edit", form.Encode(), "admin")
	assertStatus(t, response, http.StatusSeeOther)
	if location := response.Header.Get("Location"); location != "/users/user-alice?updated=1" {
		t.Fatalf("redirect location = %q", location)
	}
	response.Body.Close()

	response = request(t, client, http.MethodGet, server.URL+"/users/user-alice?updated=1", "", "admin")
	assertStatus(t, response, http.StatusOK)
	assertBodyContains(t, response, "Alice Tanaka Updated", "Design", "Enterprise", "Changes saved.")

	response = request(t, client, http.MethodGet, server.URL+"/users", "", "anonymous")
	assertStatus(t, response, http.StatusForbidden)
	assertBodyContains(t, response, "Access denied", "Forma", "allow")

	response = request(t, client, http.MethodPut, server.URL+"/users/user-alice/edit", "", "admin")
	assertStatus(t, response, http.StatusMethodNotAllowed)
	if allow := response.Header.Get("Allow"); allow != "GET, POST" {
		t.Fatalf("Allow = %q", allow)
	}
	response.Body.Close()

	response = request(t, client, http.MethodGet, server.URL+"/__test/principal?role=admin&next=%2f%5c%5cevil.example", "", "admin")
	assertStatus(t, response, http.StatusBadRequest)
	response.Body.Close()
}

func TestFixtureValidationRejectsDanglingRelation(t *testing.T) {
	var spec adminSpec
	if err := json.Unmarshal([]byte(generatedSpecJSON), &spec); err != nil {
		t.Fatal(err)
	}
	var fixtures fixtureSet
	if err := json.Unmarshal([]byte(generatedFixturesJSON), &fixtures); err != nil {

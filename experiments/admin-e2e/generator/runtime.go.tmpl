	}
	return cloneRecords([]record{s.entities[entity][index]})[0], true
}

func (s *memoryStore) update(entity, id string, values map[string]string) bool {
	s.mu.Lock()
	defer s.mu.Unlock()
	index, ok := s.indexes[entity][id]
	if !ok {
		return false
	}
	for key, value := range values {
		s.entities[entity][index].Values[key] = value
	}
	return true

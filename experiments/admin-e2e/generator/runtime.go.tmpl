    main { width:min(1080px, calc(100% - 40px)); margin:38px auto 72px; }
    .eyebrow { color:#6b7590; font-size:12px; font-weight:750; letter-spacing:.12em; text-transform:uppercase; }
    h1 { margin:8px 0 24px; font-size:30px; line-height:1.2; letter-spacing:-.025em; }
    .card { overflow:hidden; border:1px solid #dfe4ef; border-radius:14px; background:#fff; box-shadow:0 8px 30px rgba(27,40,76,.06); }
    .card-body { padding:28px; }
    table { width:100%; border-collapse:collapse; }
    th, td { padding:15px 18px; text-align:left; border-bottom:1px solid #e9edf5; }
    th { color:#66718a; background:#fafbfe; font-size:12px; letter-spacing:.06em; text-transform:uppercase; }
    tr:last-child td { border-bottom:0; }
    tbody tr:hover { background:#fafbff; }
    td.empty { padding:38px 18px; color:#6b7590; text-align:center; }
    .actions { display:flex; justify-content:flex-end; gap:14px; white-space:nowrap; }
    .button { display:inline-flex; align-items:center; justify-content:center; min-height:40px; padding:0 16px; border:0; border-radius:9px; background:#4967db; color:#fff; cursor:pointer; font:inherit; font-weight:700; }
    .button:hover { background:#3656ca; text-decoration:none; }
    .button:disabled { cursor:wait; opacity:.7; }
    .button.secondary { color:#354052; background:#eef1f7; }
    .toolbar { display:flex; align-items:center; justify-content:space-between; margin-bottom:18px; }
    .back { font-size:14px; font-weight:650; }
    dl { margin:0; }
    .datum { display:grid; grid-template-columns:180px 1fr; gap:24px; padding:18px 0; border-bottom:1px solid #e9edf5; }
    .datum:last-child { border-bottom:0; }
    dt { color:#6c758a; font-weight:650; }
    dd { margin:0; }
    form { display:grid; gap:20px; }
    label { display:grid; gap:8px; color:#465168; font-size:14px; font-weight:700; }
    input, select { width:100%; padding:11px 12px; border:1px solid #cfd6e5; border-radius:9px; background:#fff; color:#172033; font:inherit; outline:none; }
    input:focus, select:focus { border-color:#627aea; box-shadow:0 0 0 3px rgba(98,122,234,.15); }
    .required { color:#c2404b; }
    .notice { margin-bottom:20px; padding:12px 14px; border-radius:9px; background:#eaf8f0; color:#216842; font-weight:650; }
    .error { margin-bottom:20px; padding:12px 14px; border-radius:9px; background:#fff0f1; color:#a92d3b; font-weight:650; }
    .hero { display:grid; gap:18px; padding:34px; }
    .role-links { display:flex; flex-wrap:wrap; gap:12px; }
    .muted { color:#6b7590; line-height:1.65; }
    .forbidden { max-width:620px; }
    @media (max-width:720px) { .topbar { padding:0 20px; } main { width:min(100% - 24px, 1080px); margin-top:26px; } .table-wrap { overflow:auto; } .datum { grid-template-columns:1fr; gap:7px; } }
  </style>
</head>
<body>
  <header class="topbar"><div class="brand"><span class="mark">F</span>Forma admin experiment</div><span class="role">role: {{.Role}}</span></header>
  <main>
    {{if eq .Kind "home"}}
      <section class="card hero"><div class="eyebrow">Generated application</div><h1>{{.Heading}}</h1><p class="muted">Choose a test principal. This adapter exists only to exercise Forma role rules before Identity semantics are designed.</p><div class="role-links">{{range .Roles}}<a class="button" href="/__test/principal?role={{.}}&next={{$.BasePath}}">Continue as {{.}}</a>{{end}}<a class="button secondary" href="/__test/principal?role=anonymous&next={{.BasePath}}">Continue anonymously</a></div></section>
    {{else if eq .Kind "list"}}
      <div class="eyebrow">Administration</div><h1>{{.Heading}}</h1><section class="card table-wrap"><table><thead><tr>{{range .Headers}}<th>{{.}}</th>{{end}}{{if .HasActions}}<th><span class="visually-hidden">Actions</span></th>{{end}}</tr></thead><tbody>{{range .Rows}}<tr>{{range .Cells}}<td>{{if .}}{{.}}{{else}}—{{end}}</td>{{end}}{{if .Actions}}<td class="actions">{{range .Actions}}<a href="{{.URL}}">{{.Label}}</a>{{end}}</td>{{end}}</tr>{{else}}<tr><td class="empty" colspan="{{$.ColumnCount}}">{{$.EmptyMessage}}</td></tr>{{end}}</tbody></table></section>
    {{else if eq .Kind "detail"}}
      <div class="toolbar"><a class="back" href="{{.BasePath}}">← Back to list</a><div>{{range .Actions}}<a class="button" href="{{.URL}}">{{.Label}}</a>{{end}}</div></div><div class="eyebrow">Record detail</div><h1>{{.Heading}}</h1>{{if .Updated}}<div class="notice" role="status">Changes saved.</div>{{end}}<section class="card card-body"><dl>{{range .Fields}}<div class="datum"><dt>{{.Label}}</dt><dd>{{if .Display}}{{.Display}}{{else}}—{{end}}</dd></div>{{end}}</dl></section>
    {{else if eq .Kind "edit"}}
      <div class="toolbar"><a class="back" href="{{.BasePath}}/{{.RecordID}}">← Cancel</a></div><div class="eyebrow">Edit record</div><h1>{{.Heading}}</h1>{{if and .FailureFeedback .Error}}<div class="error" role="alert">{{.Error}}</div>{{end}}<section class="card card-body"><form method="post" action="{{.BasePath}}/{{.RecordID}}/edit" data-prevent-duplicate="{{.PreventDuplicateDispatch}}">{{if .SubmissionToken}}<input type="hidden" name="_forma_submission" value="{{.SubmissionToken}}">{{end}}{{range .Fields}}<label>{{.Label}}{{if .Required}} <span class="required">required</span>{{end}}{{if .Select}}<select name="{{.Name}}" {{if .Required}}required{{end}}><option value="" {{if not .Value}}selected{{end}}>{{if .Required}}Select {{.Label}}{{else}}No selection{{end}}</option>{{range .Options}}<option value="{{.Value}}" {{if .Selected}}selected{{end}}>{{.Label}}</option>{{end}}</select>{{else}}<input name="{{.Name}}" type="{{.InputType}}" value="{{.Value}}" {{if .Required}}required{{end}}>{{end}}</label>{{end}}<div><button class="button" type="submit" data-pending-label="Saving…">Save changes</button></div></form></section>
    {{else if eq .Kind "forbidden"}}
      <section class="card card-body forbidden"><div class="eyebrow">HTTP 403</div><h1>{{.Heading}}</h1><p class="muted">The current principal does not satisfy this page's Forma <code>allow</code> rule.</p><a class="button secondary" href="/">Choose another principal</a></section>
    {{end}}
  </main>
  <script>
    document.addEventListener("submit", function (event) {
      var form = event.target;
      if (!(form instanceof HTMLFormElement) || form.dataset.preventDuplicate !== "true") return;
      if (form.dataset.dispatched === "true") {
        event.preventDefault();
        return;
      }
      form.dataset.dispatched = "true";
      form.setAttribute("aria-busy", "true");
      var button = form.querySelector('button[type="submit"]');
      if (button) {
        button.disabled = true;
        button.textContent = button.dataset.pendingLabel || "Saving…";
      }
    });
  </script>
</body>
</html>`

func main() {
	app, err := newApplication()
	if err != nil {
		log.Fatal(err)
	}
	address := os.Getenv("FORMA_ADDRESS")
	if address == "" {
		address = app.spec.DefaultAddress
	}
	log.Printf("Forma admin experiment listening on http://%s", address)
	log.Fatal(http.ListenAndServe(address, app.handler()))
}

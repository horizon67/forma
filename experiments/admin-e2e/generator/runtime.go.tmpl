// A small per-record/principal window supports several open tabs without
// retaining abandoned forms forever. This is an idempotency mechanism, not a
// CSRF defense; the experiment's test principal is only a role string.
const maxSubmissionTokensPerScope = 5

func newSubmissionGuard() *submissionGuard {
	return &submissionGuard{
		issued: map[string]submissionClaim{}, issuedByScope: map[string][]string{},
		processing: map[string]submissionClaim{}, completed: map[string]submissionCompletion{},
		completedByScope: map[string][]string{},
	}
}

func (g *submissionGuard) issue(recordID, principal string) (string, error) {
	claim := submissionClaim{recordID: recordID, principal: principal}
	for {
		buffer := make([]byte, 24)
		if _, err := rand.Read(buffer); err != nil {
			return "", fmt.Errorf("generate submission token: %w", err)
		}
		token := base64.RawURLEncoding.EncodeToString(buffer)

		g.mu.Lock()
		if !g.tokenExists(token) {
			g.issued[token] = claim
			scope := submissionScope(claim)
			g.issuedByScope[scope] = append(g.issuedByScope[scope], token)
			g.trimIssued(scope)
			g.mu.Unlock()
			return token, nil
		}
		g.mu.Unlock()
	}
}

func (g *submissionGuard) begin(token, recordID, principal string) (submissionDecision, string) {
	g.mu.Lock()
	defer g.mu.Unlock()
	want := submissionClaim{recordID: recordID, principal: principal}
	if completion, ok := g.completed[token]; ok && completion.submissionClaim == want {
		return submissionCompleted, completion.redirect
	}
	if claim, ok := g.processing[token]; ok && claim == want {
		return submissionInProgress, ""
	}
	claim, ok := g.issued[token]
	if !ok || claim != want {
		return submissionRejected, ""
	}
	delete(g.issued, token)
	scope := submissionScope(claim)
	g.issuedByScope[scope] = removeToken(g.issuedByScope[scope], token)
	g.processing[token] = claim
	return submissionAccepted, ""
}

func (g *submissionGuard) complete(token, redirect string) {
	g.mu.Lock()
	defer g.mu.Unlock()
	claim, ok := g.processing[token]
	if !ok {
		return
	}
	delete(g.processing, token)
	g.completed[token] = submissionCompletion{submissionClaim: claim, redirect: redirect}
	scope := submissionScope(claim)
	g.completedByScope[scope] = append(g.completedByScope[scope], token)
	g.trimCompleted(scope)
}

func (g *submissionGuard) fail(token string) {
	g.mu.Lock()
	defer g.mu.Unlock()
	delete(g.processing, token)
}

func (g *submissionGuard) tokenExists(token string) bool {
	if _, ok := g.issued[token]; ok {
		return true
	}
	if _, ok := g.processing[token]; ok {
		return true
	}
	_, ok := g.completed[token]
	return ok
}

func (g *submissionGuard) trimIssued(scope string) {
	tokens := g.issuedByScope[scope]
	for len(tokens) > maxSubmissionTokensPerScope {
		delete(g.issued, tokens[0])
		tokens = tokens[1:]
	}
	g.issuedByScope[scope] = tokens
}

func (g *submissionGuard) trimCompleted(scope string) {
	tokens := g.completedByScope[scope]
	for len(tokens) > maxSubmissionTokensPerScope {
		delete(g.completed, tokens[0])
		tokens = tokens[1:]
	}
	g.completedByScope[scope] = tokens
}

func submissionScope(claim submissionClaim) string {
	return claim.recordID + "\x00" + claim.principal
}

func removeToken(tokens []string, target string) []string {
	for index, token := range tokens {
		if token == target {
			return append(tokens[:index], tokens[index+1:]...)
		}
	}
	return tokens
}

func newApplication() (*application, error) {
	var spec adminSpec
	if err := json.Unmarshal([]byte(generatedSpecJSON), &spec); err != nil {
		return nil, fmt.Errorf("decode generated spec: %w", err)
	}
	var fixtures fixtureSet
	if err := json.Unmarshal([]byte(generatedFixturesJSON), &fixtures); err != nil {
		return nil, fmt.Errorf("decode generated fixtures: %w", err)
	}
	if err := validateFixtures(spec, fixtures); err != nil {
		return nil, err
	}
	ui, err := template.New("page").Parse(pageHTML)
	if err != nil {
		return nil, fmt.Errorf("parse UI template: %w", err)
	}
	return &application{spec: spec, store: newMemoryStore(fixtures), ui: ui, submissions: newSubmissionGuard()}, nil
}

func validateFixtures(spec adminSpec, fixtures fixtureSet) error {
	indexes := make(map[string]map[string]record, len(fixtures.Entities))
	for _, entity := range sortedKeys(fixtures.Entities) {
		rows := fixtures.Entities[entity]
		indexes[entity] = make(map[string]record, len(rows))
		for _, item := range rows {
			if item.ID == "" {
				return fmt.Errorf("fixture %s has an empty identity", entity)
			}
			if _, exists := indexes[entity][item.ID]; exists {
				return fmt.Errorf("fixture %s has duplicate identity %s", entity, item.ID)
			}
			indexes[entity][item.ID] = item
		}
	}
	for _, item := range fixtures.Entities[spec.Entity] {
		for _, name := range spec.FieldOrder {
			field := spec.Fields[name]
			value := item.Values[name]
			if field.Required && value == "" {
				return fmt.Errorf("fixture %s.%s is missing required field %s", spec.Entity, item.ID, name)
			}
			if field.RelationEntity != "" && value != "" {
				if _, exists := indexes[field.RelationEntity][value]; !exists {
					return fmt.Errorf("fixture %s.%s field %s refers to missing %s %s", spec.Entity, item.ID, name, field.RelationEntity, value)
				}
			}
			if len(field.Variants) != 0 && value != "" && !contains(field.Variants, value) {
				return fmt.Errorf("fixture %s.%s field %s has value outside its closed variants", spec.Entity, item.ID, name)
			}
		}
	}
	for _, entity := range sortedKeys(spec.RelatedLabels) {
		labelField := spec.RelatedLabels[entity]
		for _, item := range fixtures.Entities[entity] {
			if item.Values[labelField] == "" {
				return fmt.Errorf("fixture %s.%s is missing label field %s", entity, item.ID, labelField)
			}
		}
	}
	return nil
}

func (a *application) handler() http.Handler {
	return http.HandlerFunc(a.route)
}

func (a *application) route(w http.ResponseWriter, r *http.Request) {
	switch {
	case r.URL.Path == "/":
		a.home(w, r)
	case r.URL.Path == "/__test/principal":
		a.selectPrincipal(w, r)
	case r.URL.Path == a.spec.BasePath:
		a.list(w, r)
	case strings.HasPrefix(r.URL.Path, a.spec.BasePath+"/"):
		a.member(w, r)
	default:
		http.NotFound(w, r)
	}
}

func (a *application) home(w http.ResponseWriter, r *http.Request) {
	if r.Method != http.MethodGet {
		methodNotAllowed(w, http.MethodGet)
		return
	}
	a.render(w, http.StatusOK, pageData{
		Kind: "home", Title: a.spec.Title, Heading: a.spec.Title, Role: principalRole(r),
		Roles: a.spec.Roles, BasePath: a.spec.BasePath,
	})
}

func (a *application) selectPrincipal(w http.ResponseWriter, r *http.Request) {
	if r.Method != http.MethodGet {
		methodNotAllowed(w, http.MethodGet)
		return
	}
	role := r.URL.Query().Get("role")
	if !contains(a.spec.Roles, role) && role != "anonymous" {
		http.Error(w, "unknown test role", http.StatusBadRequest)
		return
	}
	next := r.URL.Query().Get("next")
	if next == "" {
		next = "/"
	}
	nextURL, parseErr := url.Parse(next)
	if parseErr != nil || !strings.HasPrefix(next, "/") || strings.HasPrefix(next, "//") ||
		strings.Contains(next, `\`) || nextURL.IsAbs() || nextURL.Host != "" {
		http.Error(w, "invalid next path", http.StatusBadRequest)
		return
	}
	http.SetCookie(w, &http.Cookie{
		Name: "forma_role", Value: role, Path: "/", HttpOnly: true, SameSite: http.SameSiteLaxMode,
	})
	http.Redirect(w, r, next, http.StatusSeeOther)
}

func (a *application) list(w http.ResponseWriter, r *http.Request) {
	if r.Method != http.MethodGet {
		methodNotAllowed(w, http.MethodGet)
		return
	}
	if !a.authorize(w, r, a.spec.List) {
		return
	}
	data := pageData{
		Kind: "list", Title: a.spec.CollectionTitle, Heading: a.spec.CollectionTitle, Role: principalRole(r),
		BasePath: a.spec.BasePath,
	}
	for _, name := range a.spec.List.Fields {
		data.Headers = append(data.Headers, a.spec.Fields[name].Label)
	}
	relations := a.relationPresentationIndex()
	for _, item := range a.store.list(a.spec.Entity) {
		row := tableRow{ID: item.ID}
		for _, name := range a.spec.List.Fields {
			row.Cells = append(row.Cells, a.displayValueFrom(name, item.Values[name], relations))
		}
		row.Actions = a.actionLinks(a.spec.List.Actions, item.ID, principalRole(r))
		data.Rows = append(data.Rows, row)
	}
	data.HasActions = len(a.spec.List.Actions) != 0
	data.ColumnCount = len(data.Headers)
	if data.HasActions {
		data.ColumnCount++
	}
	if len(data.Rows) == 0 && contains(a.spec.List.InteractionStates, "empty") {
		data.EmptyMessage = "No " + strings.ToLower(a.spec.CollectionTitle) + " found."
	}
	a.render(w, http.StatusOK, data)
}

func (a *application) member(w http.ResponseWriter, r *http.Request) {
	remainder := strings.TrimPrefix(r.URL.Path, a.spec.BasePath+"/")
	parts := strings.Split(remainder, "/")
	if len(parts) == 1 && parts[0] != "" {
		a.detail(w, r, parts[0])
		return
	}
	if len(parts) == 2 && parts[0] != "" && parts[1] == "edit" {
		a.edit(w, r, parts[0])
		return
	}
	http.NotFound(w, r)
}

func (a *application) detail(w http.ResponseWriter, r *http.Request, id string) {
	if r.Method != http.MethodGet {
		methodNotAllowed(w, http.MethodGet)
		return
	}
	if !a.authorize(w, r, a.spec.Detail) {
		return
	}
	item, ok := a.store.get(a.spec.Entity, id)
	if !ok {
		http.NotFound(w, r)
		return
	}
	a.render(w, http.StatusOK, pageData{
		Kind: "detail", Title: a.recordTitle(item), Heading: a.recordTitle(item), Role: principalRole(r),
		BasePath: a.spec.BasePath, RecordID: item.ID, Fields: a.viewFields(a.spec.Detail.Fields, item, false),
		Updated: r.URL.Query().Get("updated") == "1", Actions: a.actionLinks(a.spec.Detail.Actions, item.ID, principalRole(r)),
	})
}

func (a *application) edit(w http.ResponseWriter, r *http.Request, id string) {
	if !a.authorize(w, r, a.spec.Edit) {
		return
	}
	item, ok := a.store.get(a.spec.Entity, id)
	if !ok {
		http.NotFound(w, r)
		return
	}
	switch r.Method {
	case http.MethodGet:
		a.renderEdit(w, r, item, "")
	case http.MethodPost:
		principal := principalRole(r)
		if a.spec.Edit.Submit == nil || !accessAllowed(principal, a.spec.Edit.Submit.Access) {
			a.render(w, http.StatusForbidden, pageData{
				Kind: "forbidden", Title: "Access denied", Heading: "Access denied", Role: principalRole(r),
				BasePath: a.spec.BasePath,
			})
			return
		}
		if err := r.ParseForm(); err != nil {
			http.Error(w, "invalid form", http.StatusBadRequest)
			return
		}
		submissionToken := r.FormValue("_forma_submission")
		guarded := a.spec.Edit.Submit.PreventDuplicateDispatch
		if guarded {
			decision, redirect := a.submissions.begin(submissionToken, id, principal)
			switch decision {
			case submissionAccepted:
			case submissionCompleted:
				http.Redirect(w, r, redirect, http.StatusSeeOther)
				return
			case submissionInProgress:
				http.Error(w, "submission is already being processed", http.StatusConflict)
				return
			default:
				for _, name := range a.spec.Edit.Fields {
					item.Values[name] = strings.TrimSpace(r.FormValue(name))
				}
				a.renderEditWithStatus(w, r, item, "This form expired. Review the values and save again.", http.StatusConflict)
				return
			}
		}
		values := make(map[string]string, len(a.spec.Edit.Fields))
		validationMessage := ""
		for _, name := range a.spec.Edit.Fields {
			value := strings.TrimSpace(r.FormValue(name))
			field := a.spec.Fields[name]
			if validationMessage == "" && field.Required && value == "" {
				validationMessage = field.Label + " is required"
			}
			if validationMessage == "" && field.RelationEntity != "" && value != "" {
				if _, exists := a.store.get(field.RelationEntity, value); !exists {
					validationMessage = field.Label + " is not selectable"
				}
			}
			if validationMessage == "" && len(field.Variants) != 0 && value != "" && !contains(field.Variants, value) {
				validationMessage = field.Label + " is not an allowed value"
			}
			values[name] = value
		}
		if validationMessage != "" {
			if guarded {
				a.submissions.fail(submissionToken)
			}
			for key, value := range values {
				item.Values[key] = value
			}
			a.renderEdit(w, r, item, validationMessage)
			return
		}
		if !a.store.update(a.spec.Entity, id, values) {
			if guarded {
				a.submissions.fail(submissionToken)
			}
			http.NotFound(w, r)
			return
		}
		successURL := a.submitSuccessURL(id) + "?updated=1"
		if guarded {
			a.submissions.complete(submissionToken, successURL)
		}
		http.Redirect(w, r, successURL, http.StatusSeeOther)
	default:
		methodNotAllowed(w, http.MethodGet, http.MethodPost)
	}
}

func (a *application) renderEdit(w http.ResponseWriter, r *http.Request, item record, message string) {
	a.renderEditWithStatus(w, r, item, message, statusForMessage(message))
}

func (a *application) renderEditWithStatus(w http.ResponseWriter, r *http.Request, item record, message string, status int) {
	submissionToken := ""
	preventDuplicateDispatch := false
	failureFeedback := false
	if a.spec.Edit.Submit != nil {
		preventDuplicateDispatch = a.spec.Edit.Submit.PreventDuplicateDispatch
		failureFeedback = a.spec.Edit.Submit.FailureFeedback
		if preventDuplicateDispatch {
			var err error
			submissionToken, err = a.submissions.issue(item.ID, principalRole(r))
			if err != nil {
				http.Error(w, "create submission token", http.StatusInternalServerError)
				return
			}
		}
	}
	a.render(w, status, pageData{
		Kind: "edit", Title: "Edit " + a.recordTitle(item), Heading: "Edit " + a.recordTitle(item),
		Role: principalRole(r), BasePath: a.spec.BasePath, RecordID: item.ID,
		Fields: a.viewFields(a.spec.Edit.Fields, item, true), Error: message,
		SubmissionToken: submissionToken, PreventDuplicateDispatch: preventDuplicateDispatch,
		FailureFeedback: failureFeedback,
	})
}

func (a *application) authorize(w http.ResponseWriter, r *http.Request, page presentationSpec) bool {
	role := principalRole(r)
	if len(page.Allows) == 0 || contains(page.Allows, role) {
		return true
	}
	a.render(w, http.StatusForbidden, pageData{
		Kind: "forbidden", Title: "Access denied", Heading: "Access denied", Role: role,
		BasePath: a.spec.BasePath,
	})
	return false
}

func accessAllowed(role string, access accessSpec) bool {
	for _, requirement := range access.AllOf {
		if !contains(requirement.AnyOf, role) {
			return false
		}
	}
	return true
}

func (a *application) viewFields(names []string, item record, editing bool) []viewField {
	fields := make([]viewField, 0, len(names))
	relations := a.relationPresentationIndex()
	for _, name := range names {
		spec := a.spec.Fields[name]
		field := viewField{
			Name: name, Label: spec.Label, Value: item.Values[name],
			Display: a.displayValueFrom(name, item.Values[name], relations),
			Required: spec.Required, InputType: spec.InputType,
			Select: spec.RelationEntity != "" || len(spec.Variants) != 0,
		}
		if editing && len(spec.Variants) != 0 {
			for _, variant := range spec.Variants {
				field.Options = append(field.Options, selectOption{
					Value: variant, Label: variant, Selected: variant == item.Values[name],
				})
			}
		} else if editing && spec.RelationEntity != "" {
			for _, option := range relations[spec.RelationEntity].Options {
				option.Selected = option.Value == item.Values[name]
				field.Options = append(field.Options, option)
			}
		}
		fields = append(fields, field)
	}
	return fields
}

func (a *application) displayValueFrom(fieldName, value string, relations map[string]relationPresentation) string {
	field := a.spec.Fields[fieldName]
	if field.RelationEntity == "" || value == "" {
		return value
	}
	label, ok := relations[field.RelationEntity].Labels[value]
	if !ok {
		return value
	}
	return label
}

func (a *application) relationPresentationIndex() map[string]relationPresentation {
	result := make(map[string]relationPresentation, len(a.spec.RelatedLabels))
	for entity, labelField := range a.spec.RelatedLabels {
		presentation := relationPresentation{Labels: map[string]string{}}
		for _, item := range a.store.labeledRecords(entity, labelField) {
			presentation.Labels[item.ID] = item.Label
			presentation.Options = append(presentation.Options, selectOption{Value: item.ID, Label: item.Label})
		}
		result[entity] = presentation
	}
	return result
}

func (a *application) actionLinks(actions []actionSpec, id, role string) []actionLink {
	links := make([]actionLink, 0, len(actions))
	for _, action := range actions {
		if !accessAllowed(role, action.Access) {
			continue
		}
		target := a.pageURL(action.TargetPage, id)
		if target == "" {
			continue
		}
		label := map[string]string{"view": "View", "edit": "Edit"}[action.Name]
		links = append(links, actionLink{Label: label, URL: target})
	}
	return links
}

func (a *application) submitSuccessURL(id string) string {
	if a.spec.Edit.Submit == nil {
		return ""
	}
	return a.pageURL(a.spec.Edit.Submit.Success.Page, id)
}

func (a *application) pageURL(pageName, id string) string {
	switch pageName {
	case a.spec.List.PageName:
		return a.spec.BasePath
	case a.spec.Detail.PageName:
		return a.spec.BasePath + "/" + url.PathEscape(id)
	case a.spec.Edit.PageName:
		return a.spec.BasePath + "/" + url.PathEscape(id) + "/edit"
	default:
		return ""
	}
}

func (a *application) recordTitle(item record) string {
	if a.spec.EntityLabel != "" && item.Values[a.spec.EntityLabel] != "" {
		return item.Values[a.spec.EntityLabel]
	}
	return a.spec.EntityTitle + " " + item.ID
}

func (a *application) render(w http.ResponseWriter, status int, data pageData) {
	var output bytes.Buffer
	if err := a.ui.Execute(&output, data); err != nil {
		http.Error(w, "render page", http.StatusInternalServerError)
		log.Printf("render page: %v", err)
		return
	}
	w.Header().Set("Content-Type", "text/html; charset=utf-8")
	w.WriteHeader(status)
	_, _ = output.WriteTo(w)
}

func principalRole(r *http.Request) string {
	cookie, err := r.Cookie("forma_role")
	if err != nil || cookie.Value == "" {
		return "anonymous"
	}
	return cookie.Value
}

func methodNotAllowed(w http.ResponseWriter, allowed ...string) {
	w.Header().Set("Allow", strings.Join(allowed, ", "))
	http.Error(w, "method not allowed", http.StatusMethodNotAllowed)
}

func contains(values []string, candidate string) bool {
	for _, value := range values {
		if value == candidate {
			return true
		}
	}
	return false
}

func sortedKeys[T any](values map[string]T) []string {
	keys := make([]string, 0, len(values))
	for key := range values {
		keys = append(keys, key)
	}
	sort.Strings(keys)
	return keys
}

func statusForMessage(message string) int {
	if message == "" {
		return http.StatusOK
	}
	return http.StatusUnprocessableEntity
}

type pageData struct {
	Kind                     string
	Title                    string
	Heading                  string
	Role                     string
	Roles                    []string
	BasePath                 string
	Headers                  []string
	Rows                     []tableRow
	HasActions               bool
	ColumnCount              int
	EmptyMessage             string
	RecordID                 string
	Fields                   []viewField
	Actions                  []actionLink
	Updated                  bool
	Error                    string
	SubmissionToken          string
	PreventDuplicateDispatch bool
	FailureFeedback          bool
}

type tableRow struct {
	ID    string
	Cells []string
	Actions []actionLink
}

type actionLink struct {
	Label string
	URL   string
}

type viewField struct {
	Name      string
	Label     string
	Value     string
	Display   string
	Required  bool
	InputType string
	Select    bool
	Options   []selectOption
}

type selectOption struct {
	Value    string
	Label    string
	Selected bool
}

type relationPresentation struct {
	Labels  map[string]string
	Options []selectOption
}

const pageHTML = `<!doctype html>

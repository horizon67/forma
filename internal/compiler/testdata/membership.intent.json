{
  "version": "forma/resolved-intent/v0.5",
  "types": [
    {
      "id": "type/Email",
      "name": "Email",
      "kind": "scalar",
      "base": "String",
      "constraints": [
        {
          "id": "type/Email/constraint/matches",
          "kind": "matches",
          "value": ".+@.+"
        }
      ]
    }
  ],
  "entities": [
    {
      "id": "entity/User",
      "name": "User",
      "fields": [
        {
          "id": "entity/User/field/name",
          "name": "name",
          "type": "String",
          "required": true
        },
        {
          "id": "entity/User/field/nickname",
          "name": "nickname",
          "type": "String"
        },
        {
          "id": "entity/User/field/email",
          "name": "email",
          "type": "Email",
          "required": true,
          "unique": true
        }
      ],
      "state": {
        "id": "entity/User/state/status",
        "name": "status",
        "initial": "Pending",
        "values": [
          "Pending",
          "Active",
          "Suspended"
        ]
      }
    }
  ],
  "actions": [
    {
      "id": "action/User/activate",
      "entity": "User",
      "name": "activate",
      "sources": [
        "Pending"
      ],
      "destination": "Active"
    }
  ],

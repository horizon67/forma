          "credential-binding",
          "notice-emission-record",
          "subject",
          "verification-evidence"
        ],
        "existingIdentifierOutcome": "reject-and-guide-resend"
      },
      "verifications": [
        {
          "id": "identity/UserAccount/verification/email",
